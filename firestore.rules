rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // --- Entity Validators ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 256 &&
             data.role is string && (data.role == 'user' || data.role == 'admin');
    }
    
    function isValidVideoJob(data) {
      return data.keys().hasAll(['userId', 'videoUrl', 'status', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.videoUrl is string && data.videoUrl.size() <= 1024 &&
             data.status is string && (data.status == 'pending' || data.status == 'processing' || data.status == 'completed' || data.status == 'failed') &&
             data.createdAt is timestamp;
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['userId', 'stripeCustomerId', 'status', 'plan']) &&
             data.userId is string &&
             data.stripeCustomerId is string &&
             data.status is string &&
             data.plan is string;
    }

    function isValidServiceConfig(data) {
      return data.keys().hasAny(['address', 'instagramHandle']) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 512)) &&
             (!('instagramHandle' in data) || (data.instagramHandle is string && data.instagramHandle.size() <= 128));
    }

    // --- Collections ---
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().role == existing().role;
    }

    match /videoJobs/{jobId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidVideoJob(incoming());
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    match /config/service {
      allow read: if true;
      allow write: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
