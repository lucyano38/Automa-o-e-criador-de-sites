# Porta do servico de edicao (padrao 3000)
PORT=3000

# Caminhos opcionais dos binarios do FFmpeg (se nao estiverem no PATH)
# FFMPEG_PATH=/caminho/ffmpeg.exe
# FFPROBE_PATH=/caminho/ffprobe.exe

# Modelo Whisper (padrao: models/ggml-small.bin)
# WHISPER_MODEL=/caminho/ggml-small.bin

# URL publica deste servico, usada pelo site focoemdados.com.br
# VIDEO_EDITOR_PUBLIC_URL=https://editor.seudominio.com
