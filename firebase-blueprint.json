{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a system user.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["email", "role"]
    },
    "VideoJob": {
      "title": "VideoJob",
      "description": "Represents an automated video editing job.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "videoUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "videoUrl", "status", "createdAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Represents a user's subscription to paid features.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "stripeCustomerId": { "type": "string" },
        "status": { "type": "string" },
        "plan": { "type": "string" }
      },
      "required": ["userId", "stripeCustomerId", "status", "plan"]
    },
    "ServiceConfig": {
      "title": "ServiceConfig",
      "description": "Represents service settings like address and social handles.",
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "instagramHandle": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/videoJobs/{jobId}": {
      "schema": "VideoJob",
      "description": "Video editing tasks."
    },
    "/subscriptions/{subId}": {
      "schema": "Subscription",
      "description": "Subscription records."
    },
    "/config/service": {
      "schema": "ServiceConfig",
      "description": "Global service settings."
    }
  }
}
